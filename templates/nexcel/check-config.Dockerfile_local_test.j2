{% if haproxy_check_version is defined %}
FROM {{haproxy_image_name}}:{{haproxy_check_version}}
{% else %}
FROM {{haproxy_image_name}}:{{haproxy_version}}
{% endif %}
COPY haproxy.cfg {{image_config_path}}/haproxy.cfg
COPY whitelisted.ips {{image_config_path}}/whitelisted.ips
COPY nexdev.net.pem {{image_config_path}}/nexdev.net.pem
COPY nexcel.vn.pem {{image_config_path}}/nexcel.vn.pem
COPY maps/default.map {{image_config_path}}/default.map
COPY maps/nexops.map {{image_config_path}}/nexops.map
COPY maps/rome.map {{image_config_path}}/rome.map
COPY maps/olympus.map {{image_config_path}}/olympus.map
COPY maps/nexus.map {{image_config_path}}/nexus.map
COPY maps/nex3.map {{image_config_path}}/nex3.map
COPY maps/legion.map {{image_config_path}}/legion.map