{% if haproxy_check_version is defined %}
FROM {{haproxy_image_name}}:{{haproxy_check_version}}
{% else %}
FROM {{haproxy_image_name}}:{{haproxy_version}}
{% endif %}
COPY nexdev.net.pem {{image_config_path}}/nexdev.net.pem
COPY nexcel.vn.pem {{image_config_path}}/nexcel.vn.pem
COPY configs/haproxy.cfg {{image_config_path}}/haproxy.cfg
COPY maps/hosts.map {{image_config_path}}/maps/hosts.map
COPY maps/vg3-game-proxy.map {{image_config_path}}/maps/vg3-game-proxy.map
COPY maps/alpha.map {{image_config_path}}/maps/alpha.map