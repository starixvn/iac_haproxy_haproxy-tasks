{% if haproxy_check_version is defined %}
FROM {{haproxy_image_name}}:{{haproxy_check_version}}
{% else %}
FROM {{haproxy_image_name}}:{{haproxy_version}}
{% endif %}
COPY haproxy.cfg {{image_config_path}}/haproxy.cfg
#COPY whitelisted.ips {{image_config_path}}/whitelisted.ips
COPY lumigame.com.pem {{image_config_path}}/lumigame.com.pem
COPY hosts.map {{image_config_path}}/hosts.map
COPY l2-game-proxy.map {{image_config_path}}/l2-game-proxy.map
COPY l2-game-proxy1.map {{image_config_path}}/l2-game-proxy1.map
COPY l1-game-proxy2.map {{image_config_path}}/l1-game-proxy2.map
COPY l1-game-proxy1.map {{image_config_path}}/l1-game-proxy1.map
COPY l1-game-proxy.map {{image_config_path}}/l1-game-proxy.map