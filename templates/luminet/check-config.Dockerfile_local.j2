{% if haproxy_check_version is defined %}
FROM {{haproxy_image_name}}:{{haproxy_check_version}}
{% else %}
FROM {{haproxy_image_name}}:{{haproxy_version}}
{% endif %}
COPY configs/haproxy.cfg {{image_config_path}}/haproxy.cfg
COPY lumigame.com.pem {{image_config_path}}/lumigame.com.pem
COPY maps/hosts.map {{image_config_path}}/maps/hosts.map
COPY maps/l2-game-proxy.map {{image_config_path}}/maps/l2-game-proxy.map
COPY maps/l2-game-proxy1.map {{image_config_path}}/maps/l2-game-proxy1.map
COPY maps/l1-game-proxy2.map {{image_config_path}}/maps/l1-game-proxy2.map
COPY maps/l1-game-proxy1.map {{image_config_path}}/maps/l1-game-proxy1.map
COPY maps/l1-game-proxy.map {{image_config_path}}/maps/l1-game-proxy.map
COPY maps/l1-game-admin.map {{image_config_path}}/maps/l1-game-admin.map